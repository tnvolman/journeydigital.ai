# Consultation form email delivery (Resend)
# https://resend.com — create an API key and verify your sending domain
RESEND_API_KEY=

# From address must be on a verified Resend domain (or use onboarding@resend.dev for tests)
CONSULTATION_FROM_EMAIL=Journey Digital <hello@journeydigital.ai>

# Inbox that receives consultation leads
CONSULTATION_TO_EMAIL=hello@journeydigital.ai

# Public site URL (used in email footers / absolute links)
NEXT_PUBLIC_SITE_URL=https://journeydigital.ai
