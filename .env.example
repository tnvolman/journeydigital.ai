# Consultation form email (Resend). Until Zoho SMTP on journeydigital.ai is ready.
# Leave unset in local/dev — the form still accepts and persists submissions.

# Required to send email
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend onboarding sender for testing:
# Journey Digital <onboarding@resend.dev>
CONTACT_FROM_EMAIL=
